# Gere e preencha uma chave privada: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SUPABASE_URL=https://projeto.supabase.co
SUPABASE_SERVICE_KEY=

# Opcional; habilite apenas em desenvolvimento local.
FLASK_DEBUG=0
# Em produção, mantenha APP_ENV=production e FLASK_DEBUG=0.
APP_ENV=development
# Em produção com múltiplos workers, use armazenamento compartilhado (ex.: Redis).
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# PROXY_HOPS deve refletir somente a quantidade real de proxies confiáveis.
PROXY_HOPS=0
